# Copy this file to .env and fill in your values.
# Never commit the real .env file.

DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/myrep

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Document upload settings
DOCUMENT_STORAGE_PATH=storage/documents
MAX_DOCUMENT_SIZE_MB=10

# Text chunking (Layer 2.3)
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# Gemini Embeddings (Layer 2.4)
# Obtain your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# Qdrant Cloud (Layers 2.5 and 2.6)
# Obtain your cluster URL and API key from https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=myrep_knowledge
RETRIEVAL_TOP_K=5

# Gemini Generation (Layer 2.7)
# Uses the same GEMINI_API_KEY as embeddings
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=1024

# RAG Evidence Control (Layer 2.8)
# RAG_MIN_SCORE: minimum cosine similarity (0.0 = disabled, 0.4–0.5 is a reasonable threshold)
# Tune after observing your actual score distribution with real documents.
RAG_MIN_SCORE=0.0
RAG_MAX_CONTEXT_CHARS=10000

# Session conversation context (Layer 3.6)
MAX_CONVERSATION_MESSAGES=10

# Sarvam AI voice (Layer 6) — server-side only. Never NEXT_PUBLIC_*.
# Realtime STT WebSocket currently accepts saaras:v3-realtime only.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SPEAKER=shubh
